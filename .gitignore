# Downloaded market data is not redistributed: rerun scripts/ to fetch it.
data/raw/*
data/clean/*
!data/raw/.gitkeep
!data/clean/.gitkeep

# Downloads made by the Skill's fetch.py (any case folder): not redistributed.
runs/*/raw/
outputs/*/raw/

# Python / Jupyter
__pycache__/
*.pyc
.ipynb_checkpoints/

# Secrets and local environment
.env
*.key

# macOS
.DS_Store
